{
  "name": "bars",
  "version": "0.4.0",
  "description": "A local-first idea notebook. Catch every line before it fades.",
  "license": "MIT",
  "author": "Toshon Jennings",
  "homepage": "https://toshon-jennings.github.io/bars/",
  "repository": {
    "type": "git",
    "url": "https://github.com/toshon-jennings/bars.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "start": "./script/build_and_run.sh",
    "dev": "./script/build_and_run.sh",
    "electron:dev": "./script/build_and_run.sh",
    "icon": "./script/make_icon.sh",
    "dist": "electron-builder --mac && for dmg in dist/*.dmg; do ./script/fix-dmg-background.sh \"$dmg\"; done",
    "dmg-background": "python3 script/make_dmg_background.py"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.toshonjennings.bars",
    "productName": "Bars",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "ideabrowser.js",
      "favicon.svg",
      "manifest.webmanifest",
      "icons/**/*",
      "fonts/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.dmg",
      "background": "build/background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 100,
      "contents": [
        {
          "x": 140,
          "y": 225,
          "type": "file"
        },
        {
          "x": 400,
          "y": 225,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
